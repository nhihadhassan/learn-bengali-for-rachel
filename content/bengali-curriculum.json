          "question": {
            "prompt": "So how would you ask for someone's name?",
            "options": [
              "apnar naam ki?",
              "apni naam ki?",
              "amar naam ki?",
              "ami naam ki?"
            ],
            "answer": "apnar naam ki?",
            "explanation": "Add -r and the word becomes possessive: ami → amar (my), apni → apnar (your). It is the same -r both times, which is why amar naam is 'my name' and apnar naam is 'your name'.",
            "concepts": [
              "amar apnar"
            ]
          }
        }
