        "apni forms",
        "amar apnar"
      ],
      "vocabulary": [
        {
          "id": "p-u01-l01-greetings-01",
          "bengali": "assalamualaikum",
          "script": "আসসালামু আলাইকুম",
          "english": "hello",
          "part_of_speech": "greeting",
          "pronunciation": "as-sa-laa-mu a-lay-kum",
          "register": "neutral",
          "emoji": "👋",
          "context_bn": "Assalamualaikum!",
          "context_script": "আসসালামু আলাইকুম!",
          "context_en": "The everyday hello in Bangladesh, at any hour."
        },
        {
          "id": "p-u01-l01-greetings-02",
          "bengali": "walaikum assalam",
          "script": "ওয়ালাইকুম আসসালাম",
          "english": "hello (reply)",
          "part_of_speech": "greeting",
          "pronunciation": "wa-lay-kum as-sa-laam",
          "register": "neutral",
          "context_bn": "— Assalamualaikum. — Walaikum assalam.",
          "context_script": "— আসসালামু আলাইকুম। — ওয়ালাইকুম আসসালাম।",
          "context_en": "This is the answer to that hello. It is only ever the reply."
        },
        {
          "id": "p-u01-l01-greetings-03",
          "bengali": "dhonnobad",
          "script": "ধন্যবাদ",
          "english": "thank you",
          "part_of_speech": "expression",
          "pronunciation": "dhon-no-baad",
          "register": "neutral",
          "emoji": "🙏",
          "context_bn": "Ji, dhonnobad.",
          "context_script": "জি, ধন্যবাদ।",
          "context_en": "Yes, thank you."
        },
        {
          "id": "p-u01-l02-how-are-you-03",
          "bengali": "khub bhalo",
          "script": "খুব ভালো",
          "english": "very good",
          "part_of_speech": "expression",
          "pronunciation": "khub bha-lo",
          "register": "neutral",
          "context_bn": "Ami khub bhalo achi.",
          "context_script": "আমি খুব ভালো আছি।",
          "context_en": "I'm very well. — khub means very."
        },
        {
          "id": "p-u01-l02-how-are-you-04",
          "bengali": "motamuti",
          "script": "মোটামুটি",
          "english": "so-so",
          "part_of_speech": "expression",
          "pronunciation": "mo-taa-mu-ti",
          "register": "neutral",
          "context_bn": "Ami motamuti achi.",
          "context_script": "আমি মোটামুটি আছি।",
          "context_en": "I'm so-so. — the honest answer when you are not quite bhalo."
        }
      ],
      "phrase_patterns": [
        {
          "id": "bn-u01-p-ji-dhonnobad",
          "bengali": "ji, dhonnobad",
          "script": "জি, ধন্যবাদ",
          "english": "yes, thank you",
          "pronunciation": "jee, dhon-no-baad",
          "register": "apni",
          "context_bn": "— Bhalo thakben. — Ji, dhonnobad.",
          "context_script": "— ভালো থাকবেন। — জি, ধন্যবাদ।",
          "context_en": "— Take care. — Yes, thank you. ji is the polite yes that softens whatever follows it."
        },
        {
          "id": "bn-u01-v-bhalo-thakben",
          "bengali": "bhalo thakben",
          "script": "ভালো থাকবেন",
          "english": "take care (goodbye)",
          "pronunciation": "bha-lo thaak-ben",
          "register": "apni",
          "context_bn": "Bhalo thakben. — Ji, apni-o bhalo thakben.",
          "context_script": "ভালো থাকবেন। — জি, আপনিও ভালো থাকবেন।",
          "context_en": "Take care. — Yes, you take care too. The way a friendly conversation ends."
        },
        {
          "id": "bn-u01-v-apni-kemon-achen",
          "bengali": "apni kemon achen?",
          "script": "আপনি কেমন আছেন?",
          "english": "how are you?",
          "pronunciation": "ap-ni ke-mon aa-chen",
          "register": "apni",
          "context_bn": "Assalamualaikum. Apni kemon achen?",
          "context_script": "আসসালামু আলাইকুম। আপনি কেমন আছেন?",
          "context_en": "Hello. How are you? — what you ask anyone you have just met."
        },
        {
          "id": "p-u01-l02-how-are-you-02",
          "bengali": "ami bhalo achi",
          "script": "আমি ভালো আছি",
          "english": "I am well",
          "pronunciation": "a-mi bha-lo aa-chi",
          "register": "neutral",
          "context_bn": "— Apni kemon achen? — Ami bhalo achi.",
          "context_script": "— আপনি কেমন আছেন? — আমি ভালো আছি।",
          "context_en": "— How are you? — I'm well."
        },
        {
          "id": "bn-u01-v-ar-apni",
          "bengali": "ar apni?",
          "script": "আর আপনি?",
          "english": "and you?",
          "pronunciation": "aar ap-ni",
          "register": "apni",
          "context_bn": "Ami bhalo achi. Ar apni?",
          "context_script": "আমি ভালো আছি। আর আপনি?",
          "context_en": "I'm well. And you? — the two words that turn an answer back into a conversation."
        },
        {
          "id": "bn-u01-v-ami-o-bhalo-achi",
          "bengali": "ami-o bhalo achi",
          "script": "আমিও ভালো আছি",
          "english": "I am well too",
          "pronunciation": "a-mi-o bha-lo aa-chi",
          "register": "neutral",
          "context_bn": "— Ar apni? — Ami-o bhalo achi.",
          "context_script": "— আর আপনি? — আমিও ভালো আছি।",
          "context_en": "— And you? — I'm well too. The -o on the end is 'too'."
        },
        {
          "id": "bn-u01-v-apnar-naam-ki",
          "bengali": "apnar naam ki?",
          "script": "আপনার নাম কি?",
          "english": "what is your name?",
          "pronunciation": "ap-nar naam ki",
          "register": "apni",
          "context_bn": "Apnar naam ki?",
          "context_script": "আপনার নাম কি?",
          "context_en": "What is your name? — apnar is the respectful 'your'."
        },
        {
          "id": "p-u02-l01-introduce-yourself-02",
          "bengali": "amar naam Rachel",
          "script": "আমার নাম রেচেল",
          "english": "my name is Rachel",
          "pronunciation": "a-mar naam Rachel",
          "register": "neutral",
          "context_bn": "— Apnar naam ki? — Amar naam Rachel.",
          "context_script": "— আপনার নাম কি? — আমার নাম রেচেল।",
          "context_en": "— What is your name? — My name is Rachel."
        },
        {
          "id": "p-u02-l01-introduce-yourself-01",
          "bengali": "ami Rachel",
          "script": "আমি রেচেল",
          "english": "I am Rachel",
          "pronunciation": "a-mi Rachel",
          "register": "neutral",
          "context_bn": "Ami Rachel.",
          "context_script": "আমি রেচেল।",
          "context_en": "I'm Rachel. — shorter than amar naam Rachel, and just as good."
        },
        {
          "id": "bn-u01-v-dekha-kore-bhalo-laglo",
          "bengali": "apnar sathe dekha kore bhalo laglo",
          "script": "আপনার সাথে দেখা করে ভালো লাগলো",
          "english": "nice to meet you",
          "pronunciation": "ap-nar shaa-the de-kha ko-re bha-lo laag-lo",
          "register": "apni",
          "context_bn": "Apnar sathe dekha kore bhalo laglo.",
          "context_script": "আপনার সাথে দেখা করে ভালো লাগলো।",
          "context_en": "Nice to meet you. — said once, near the end of a first meeting."
        },
        {
          "id": "bn-u01-v-amar-o-bhalo-laglo",
          "bengali": "amar-o bhalo laglo",
          "script": "আমারও ভালো লাগলো",
          "english": "nice to meet you too",
          "pronunciation": "a-mar-o bha-lo laag-lo",
          "register": "neutral",
          "context_bn": "— Apnar sathe dekha kore bhalo laglo. — Amar-o bhalo laglo.",
          "context_script": "— আপনার সাথে দেখা করে ভালো লাগলো। — আমারও ভালো লাগলো।",
          "context_en": "— Nice to meet you. — Nice to meet you too."
        }
      ],
