    {
      "id": "querer-pattern",
      "targets": [
        "querer + noun"
      ],
      "title": "Quiero + what you want",
      "explanation": "Quiero means \"I want\". Whatever you want goes straight after it, so one word gets you a whole family of sentences.",
      "examples": [
        {
          "target": "Quiero un café.",
          "english": "I want a coffee.",
          "note": "quiero + the thing"
        },
        {
          "target": "Quiero un té, por favor.",
          "english": "I want a tea, please."
        },
        {
          "target": "Quiero la cuenta.",
          "english": "I want the bill."
        },
        {
          "target": "¿Quieres un café?",
          "english": "Do you want a coffee?",
          "note": "quieres = you want"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "quiero",
          "quieres",
          "quiere"
        ]
      ]
    },
    {
      "id": "buenas-agreement",
      "targets": [
        "greeting agreement"
      ],
      "title": "Buenos or buenas?",
      "explanation": "Greetings change their ending to match the word after them. Día is masculine, so buenos días; tarde and noche are feminine, so buenas tardes and buenas noches.",
      "examples": [
        {
          "target": "buenos días",
          "english": "good morning",
          "note": "día → buenos"
        },
        {
          "target": "buenas tardes",
          "english": "good afternoon",
          "note": "tarde → buenas"
        },
        {
          "target": "buenas noches",
          "english": "good evening",
          "note": "noche → buenas"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "buenos",
          "buenas"
        ]
      ]
    },
    {
      "id": "ser-de-origin",
      "targets": [
        "ser + de for origin"
      ],
      "title": "Soy de + where you're from",
      "explanation": "To say where you are from, use soy de and then the place. Ask someone else with ¿De dónde eres?",
      "examples": [
        {
          "target": "Soy de Canadá.",
          "english": "I am from Canada.",
          "note": "soy = I am"
        },
        {
          "target": "¿De dónde eres?",
          "english": "Where are you from?",
          "note": "eres = you are"
        },
        {
          "target": "Es de Lima.",
          "english": "He/She is from Lima."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "soy",
          "eres",
          "es"
        ]
      ]
    },
    {
      "id": "possessives",
      "targets": [
        "possessives mi/tu/su"
      ],
      "title": "mi, tu, su",
      "explanation": "Mi means \"my\", tu means \"your\", su means \"his\" or \"her\". They go in front of the noun and do not change for masculine or feminine.",
      "examples": [
        {
          "target": "Esta es mi hermana.",
          "english": "This is my sister.",
          "note": "mi = my"
        },
        {
          "target": "Mi país es muy grande.",
          "english": "My country is very large."
        },
        {
          "target": "¿Y tu mochila?",
          "english": "And your backpack?",
          "note": "tu = your"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "mi",
          "tu",
          "su"
        ]
      ]
    },
    {
      "id": "estar-location-hay",
      "targets": [
        "estar for location",
        "hay for existence"
      ],
      "title": "está and hay",
      "explanation": "Use está to say where a particular thing is, and hay to say that something exists at all. ¿Dónde está mi teléfono? asks about your phone; hay una silla just says a chair is there.",
      "examples": [
        {
          "target": "¿Dónde está mi teléfono?",
          "english": "Where is my phone?",
          "note": "a particular thing → está"
        },
        {
          "target": "Está al lado de la puerta.",
          "english": "It is next to the door."
        },
        {
          "target": "Hay una mochila debajo de la silla.",
          "english": "There is a backpack under the chair.",
          "note": "something exists → hay"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "está",
          "hay"
        ],
        [
          "está",
          "están"
        ]
      ]
    },
    {
      "id": "question-words",
      "targets": [
        "question words"
      ],
      "title": "qué, dónde, cómo, cuánto",
      "explanation": "Spanish questions open with ¿ and usually start with a question word. Each one carries an accent: qué (what), dónde (where), cómo (how), cuánto (how much), quién (who).",
      "examples": [
        {
          "target": "¿Cuánto cuesta?",
          "english": "How much does it cost?"
        },
        {
          "target": "¿Dónde está el hospital?",
          "english": "Where is the hospital?"
        },
        {
          "target": "¿Cómo estás?",
          "english": "How are you?"
        },
        {
          "target": "¿Quién es ella?",
          "english": "Who is she?"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "qué",
          "dónde",
          "cómo",
          "cuánto"
        ],
        [
          "quién",
          "dónde",
          "cómo"
        ]
      ]
    },
    {
      "id": "weather-hace",
      "targets": [
        "weather expressions"
      ],
      "title": "Talking about the weather",
      "explanation": "Spanish says the weather \"makes\" hot or cold: hace frío, hace sol, hace calor. Rain and snow use está instead — está lloviendo.",
      "examples": [
        {
          "target": "Hoy hace sol.",
          "english": "Today it is sunny.",
          "note": "hace + weather word"
        },
        {
          "target": "Hace mucho frío.",
          "english": "It is very cold."
        },
        {
          "target": "Está lloviendo.",
          "english": "It is raining.",
          "note": "rain → está"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "hace",
          "está"
        ]
      ]
    }
  ]
