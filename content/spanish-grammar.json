    {
      "id": "location-prepositions",
      "targets": [
        "location prepositions"
      ],
      "title": "Saying where",
      "explanation": "Position words usually end in de: encima de, debajo de, al lado de, dentro de. Cerca and lejos can stand alone.",
      "examples": [
