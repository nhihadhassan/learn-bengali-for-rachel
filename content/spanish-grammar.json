    {
      "id": "count-mass-nouns",
      "targets": [
        "count and mass noun phrases"
      ],
      "title": "A kilo of, a cup of",
      "explanation": "For things you measure rather than count, name the amount and join it with de: un kilo de manzanas, una taza de café.",
      "examples": [
        {
          "target": "Quiero un kilo de manzanas.",
          "english": "I want a kilo of apples.",
          "note": "amount + de + thing"
        },
        {
          "target": "una taza de café",
          "english": "a cup of coffee"
        },
        {
          "target": "un poco de leche",
          "english": "a little milk"
        },
        {
          "target": "¿Cuánto cuestan las naranjas?",
          "english": "How much do the oranges cost?"
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "un",
          "una",
          "unos",
          "unas"
        ],
        [
          "mucho",
          "muchos",
          "mucha",
          "muchas"
        ]
      ]
    },
    {
      "id": "gustar-preferir",
      "targets": [
        "preferences with gustar/preferir"
      ],
      "title": "Me gusta and prefiero",
      "explanation": "Gustar agrees with the thing liked, not the person: me gusta el café, me gustan las fresas. Preferir behaves like a normal verb.",
      "examples": [
        {
          "target": "Me gusta leer.",
          "english": "I like to read."
        },
        {
          "target": "Me gustan las fresas.",
          "english": "I like strawberries.",
          "note": "plural, so gustan"
        },
        {
          "target": "Prefiero cocinar en casa.",
          "english": "I prefer to cook at home."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "me gusta",
          "me gustan"
        ],
        [
          "prefiero",
          "prefieres",
          "prefiere"
        ]
      ]
    },
    {
      "id": "obligation",
      "targets": [
        "obligation: tener que/deber"
      ],
      "title": "Have to, should",
      "explanation": "Tener que is a real obligation, deber is closer to \"should\", and necesito is \"I need to\". All three take the plain verb after them.",
      "examples": [
        {
          "target": "Tengo que salir ahora.",
          "english": "I have to leave now."
        },
        {
          "target": "Debes descansar.",
          "english": "You should rest."
        },
        {
          "target": "Necesito comprar pan.",
          "english": "I need to buy bread."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "tengo que",
          "debo",
          "necesito"
        ],
        [
          "tienes que",
          "debes",
          "necesitas"
        ],
        [
          "tenemos que",
          "debemos",
          "necesitamos"
        ]
      ]
    },
    {
      "id": "formal-requests",
      "targets": [
        "formal requests"
      ],
      "title": "Being polite",
      "explanation": "With someone you don't know, use the usted form and soften the ask: ¿Podría ayudarme? Quisiera un café.",
      "examples": [
        {
          "target": "¿Puede repetir?",
          "english": "Could you repeat that?",
          "note": "puede = polite you"
        },
        {
          "target": "¿Puede hablar despacio?",
          "english": "Could you speak slowly?"
        },
        {
          "target": "¿Podría ayudarme?",
          "english": "Could you help me?"
        },
        {
          "target": "Quisiera un café, por favor.",
          "english": "I would like a coffee, please."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "puede",
          "podría",
          "quisiera"
        ],
        [
          "quiero",
          "quisiera"
        ],
        [
          "usted",
          "tú"
        ]
      ]
    },
    {
      "id": "comparatives",
      "targets": [
        "comparatives"
      ],
      "title": "More, less, better",
      "explanation": "Build a comparison with más … que or menos … que. Mejor and peor already mean \"better\" and \"worse\", so they never take más.",
      "examples": [
        {
          "target": "Es más grande que mi casa.",
          "english": "It is bigger than my house."
        },
        {
          "target": "Hoy hace menos frío.",
          "english": "Today it is less cold."
        },
        {
          "target": "Este café es mejor.",
          "english": "This coffee is better."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "más",
          "menos"
        ],
        [
          "mejor",
          "peor"
        ]
      ]
    },
    {
      "id": "opinion-frames",
      "targets": [
        "opinion frames: creo que/me parece que"
      ],
      "title": "Giving an opinion",
      "explanation": "Open an opinion with creo que, pienso que or me parece que, then finish with an ordinary sentence.",
      "examples": [
        {
          "target": "Creo que es interesante.",
          "english": "I think it is interesting."
        },
        {
          "target": "Me parece que hace frío.",
          "english": "It seems to me that it is cold."
        },
        {
          "target": "Pienso que tienes razón.",
          "english": "I think you are right."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "creo que",
          "me parece que",
          "pienso que"
        ]
      ]
    },
    {
      "id": "imperatives",
      "targets": [
        "imperatives"
      ],
      "title": "Telling someone what to do",
      "explanation": "For a friendly instruction, an -ar verb ends in -a and an -er/-ir verb ends in -e: cruza la plaza, come despacio.",
      "examples": [
        {
          "target": "Cruza la plaza.",
          "english": "Cross the square."
        },
        {
          "target": "Habla despacio, por favor.",
          "english": "Speak slowly, please."
        },
        {
          "target": "Come despacio.",
          "english": "Eat slowly."
        }
