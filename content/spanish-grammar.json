    {
      "id": "numbers",
      "targets": [
        "cardinal and ordinal numbers"
      ],
      "title": "Counting and ordering",
      "explanation": "Counting numbers don't change (dos, tres), but ordinal numbers behave like describing words: el primer día, la primera vez.",
