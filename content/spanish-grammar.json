        {
          "target": "Hay una mochila debajo de la silla.",
          "english": "There is a backpack under the chair."
        },
        {
          "target": "El parque está cerca.",
          "english": "The park is near."
        }
      ],
      "drill": "marker-cloze",
      "markerGroups": [
        [
          "encima de",
          "debajo de",
          "al lado de",
          "dentro de"
        ],
        [
          "cerca",
          "lejos",
          "aquí",
          "allí"
        ],
        [
          "entre",
          "frente a",
          "detrás de",
          "al lado de"
        ]
      ]
